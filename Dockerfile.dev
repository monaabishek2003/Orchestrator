# syntax=docker/dockerfile:1.7
# Development Dockerfile — hot reload for server (tsx watch) and web (next dev).
# Source code is bind-mounted at runtime, so rebuilds are not needed for code changes.

FROM node:20-bookworm-slim AS dev

# Build toolchain for better-sqlite3 native bindings
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 make g++ ca-certificates git \
    && rm -rf /var/lib/apt/lists/*

ENV PNPM_HOME=/pnpm
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@10.17.1 --activate

WORKDIR /repo

# Copy only manifests first → cache pnpm install layer
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY apps/server/package.json apps/server/
COPY apps/web/package.json apps/web/
COPY packages/sdk/package.json packages/sdk/
COPY examples/package.json examples/

RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile

# Source is bind-mounted via docker-compose / `docker run -v`.
# Copying it here is only a fallback for `docker run` without a volume.
COPY . .

ENV NODE_ENV=development
ENV PORT=8000
# Keep SQLite inside a mounted volume so it survives container restarts
ENV DATABASE_URL=file:/data/dev.db
RUN mkdir -p /data
VOLUME ["/data"]

# Server :8000, Next dev :3000
EXPOSE 8000 3000

# Default: run both server and web in watch mode in parallel.
# Override with e.g. `docker run ... pnpm --filter orchestrator-server dev`.
CMD ["sh", "-c", "pnpm --filter orchestrator-server dev & pnpm --filter web dev -- -H 0.0.0.0 & wait"]
