{
  "name": "orchestrator-sdk",
  "version": "0.3.1",
  "description": "Open-source Kanban board for Claude Code that doesn't just show what an agent is spending — it stops the agent the moment it spends too much.",
  "type": "module",
  "bin": {
    "orchestrator": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "claude",
    "claude-code",
    "ai-agents",
    "kanban",
    "token-budget",
    "orchestration",
    "llm",
    "automation",
    "cost-control"
  ],
  "author": "monaabishek2003",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/monaabishek2003/Orchestrator.git"
  },
  "homepage": "https://github.com/monaabishek2003/Orchestrator#readme",
  "engines": {
    "node": ">=20.11.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --parallel --filter \"@orchestrator/*\" dev",
    "dev:server": "pnpm --filter @orchestrator/server dev",
    "dev:web": "pnpm --filter @orchestrator/web dev",
    "build": "pnpm --filter @orchestrator/web build && pnpm --filter @orchestrator/server build && node scripts/assemble-dist.js",
    "typecheck": "pnpm --filter @orchestrator/server typecheck && pnpm --filter @orchestrator/web typecheck",
    "prepublishOnly": "pnpm build && node scripts/verify-dist.js"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "prisma": "^6.1.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.18",
    "@radix-ui/react-dialog": "^1.1.18",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-popover": "^1.1.18",
    "@radix-ui/react-progress": "^1.1.11",
    "@radix-ui/react-scroll-area": "^1.2.13",
    "@radix-ui/react-select": "^2.3.2",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tooltip": "^1.2.11",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.5.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.22.0",
    "next": "^14.2.21",
    "postcss": "^8.5.16",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "3",
    "tailwindcss-animate": "^1.0.7",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "zustand": "^5.0.14"
  }
}
